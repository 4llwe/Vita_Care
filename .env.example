NODE_ENV=development
# Database
DATABASE_URL=postgresql://vitacare:secret@localhost:5432/vitacare

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=please_use_a_32_byte_base64_key_

# API / Web
API_PORT=3001
API_URL=http://localhost:3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Storage (S3-compatible). Kosongkan untuk fallback penyimpanan lokal (mode dev).
S3_ENDPOINT=
S3_BUCKET=vitacare-evidence
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Direktori penyimpanan lokal saat S3 tidak dikonfigurasi
STORAGE_DIR=./storage

# Notifikasi
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_CLINICAL_TO=vitacare87@gmail.com
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_EMERGENCY_TO=+6282227420800

# Payment (Midtrans) & Maps
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
MAPS_API_KEY=

# Production seed (required only when running pnpm seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator Vita Care
SEED_MASTER_DATA=false

REDIS_PASSWORD=
POSTGRES_USER=vitacare
