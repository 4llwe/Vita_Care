NODE_ENV=production
APP_ENV=staging

# Platform container biasanya menetapkan PORT secara otomatis.
PORT=3001
API_URL=https://api-staging.example.com
WEB_ORIGIN=https://staging.example.netlify.app

# Gunakan connection string Supabase staging/preview, bukan production.
DATABASE_URL=postgresql://REPLACE_ME

# Buat masing-masing secret acak minimal 32 karakter.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Penyimpanan staging bersifat sementara sampai S3 dikonfigurasi.
STORAGE_DIR=/tmp/vitacare-storage
MIDTRANS_PRODUCTION=false

APP_VERSION=2.0.0-staging
GIT_SHA=REPLACE_ME
